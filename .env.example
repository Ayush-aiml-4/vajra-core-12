# =============================================================================
# VAJRA — Environment Variables (PLACEHOLDERS ONLY)
# Copy to `.env` for local development. Never commit real secrets.
# Generate secrets: openssl rand -hex 32
# =============================================================================

NODE_ENV="development"
APP_ENV="development"
PORT="3000"
VAJRA_SERVICE_NAME="vajra-api"

# Public origin (https://your-app.azurewebsites.net in Azure)
APP_PUBLIC_ORIGIN="http://localhost:3000"
APP_URL="http://localhost:3000"

# Trust X-Forwarded-* from Azure App Service / Front Door (true in production)
TRUST_PROXY="false"

# PostgreSQL (Prisma) — required in production; non-placeholder URL only
# Azure: use sslmode=require (see docs/deployment/azure-app-service.md)
DATABASE_URL="postgresql://username:password@localhost:5432/vajra_db?schema=public"

SESSION_SECRET=""
TOTP_ENCRYPTION_KEY=""
SESSION_TTL_SECONDS="900"
REQUIRE_MFA="true"

VAJRA_SEED_EMAIL=""
VAJRA_SEED_DISPLAY_NAME=""
VAJRA_SEED_PASSWORD=""

VITE_LOGIN_BG_VIDEO_URL="https://res.cloudinary.com/example/video/upload/sample.mp4"
GEMINI_API_KEY=""
