// VAJRA — Prisma Schema (Prompt 0004: Cryptographic Device Identity & Secure Enrollment)
// Database Provider: PostgreSQL (Never SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum DeviceType {
  WINDOWS
  ANDROID
  UNKNOWN
}

enum DeviceLifecycleState {
  UNREGISTERED
  ENROLLMENT_PENDING
  TRUSTED
  ACTIVE
  OFFLINE
  LOST
  COMPROMISED
  REVOKED
  DECOMMISSIONED
}

enum DeviceConnectivityStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum KeyAlgorithm {
  ED25519
  ECDSA_P256
}

enum DeviceCredentialStatus {
  PENDING_CONFIRMATION
  ACTIVE
  ROTATED
  REVOKED
}

enum SessionType {
  WEB_CONSOLE
  DEVICE_STREAM
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique
  displayName         String
  status              UserStatus           @default(ACTIVE)
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  credential          UserCredential?
  passkeys            PasskeyCredential[]
  sessions            DeviceSession[]
  devices             Device[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  securityEvents      SecurityEvent[]
  issuedCommands      RemoteCommand[]
  riskAssessments     RiskAssessment[]
  threatChecks        ThreatCheck[]

  @@index([email])
  @@index([status])
}

model UserCredential {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @db.Uuid
  passwordHash        String
  totpSecretEncrypted String?
  totpEnabled         Boolean  @default(false)
  recoveryCodeHashes  Json     @default("[]")
  passwordChangedAt   DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasskeyCredential {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  credentialId         String    @unique
  publicKeyBase64      String
  counter              BigInt    @default(0)
  transports           String[]
  label                String
  createdAt            DateTime  @default(now())
  lastUsedAt           DateTime?
  revokedAt            DateTime?

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Device {
  id                   String                   @id @default(uuid()) @db.Uuid
  userId               String                   @db.Uuid
  name                 String
  deviceType           DeviceType
  lifecycleState       DeviceLifecycleState     @default(ENROLLMENT_PENDING)
  connectivityStatus   DeviceConnectivityStatus @default(UNKNOWN)
  osVersion            String?
  agentVersion         String?
  currentRiskScore     Int                      @default(0)
  currentRiskLevel     RiskLevel                @default(LOW)
  lastHeartbeatAt      DateTime?
  lastSeenAt           DateTime?
  enrolledAt           DateTime?
  revokedAt            DateTime?
  compromisedAt        DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  user                 User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentials          DeviceCredential[]
  enrollmentChallenges EnrollmentChallenge[]
  authNonces           DeviceAuthNonce[]
  sessions             DeviceSession[]
  auditLogs            AuditLog[]
  notifications        Notification[]
  securityEvents       SecurityEvent[]
  remoteCommands       RemoteCommand[]
  commandResults       CommandResult[]
  heartbeats           DeviceHeartbeat[]
  riskAssessments      RiskAssessment[]
  threatChecks         ThreatCheck[]

  @@index([userId])
  @@index([lifecycleState])
}

model DeviceCredential {
  id                    String                 @id @default(uuid()) @db.Uuid
  deviceId              String                 @db.Uuid
  keyAlgorithm          KeyAlgorithm           @default(ED25519)
  publicKeyPem          String
  publicKeyFingerprint  String                 @unique
  status                DeviceCredentialStatus @default(PENDING_CONFIRMATION)
  hardwareBacked        Boolean                @default(false)
  enrollmentTokenHash   String?                @unique
  enrollmentExpiresAt   DateTime?
  active                Boolean                @default(false)
  createdAt             DateTime               @default(now())
  confirmedAt           DateTime?
  rotatedAt             DateTime?
  revokedAt             DateTime?

  device                Device                 @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([status])
}

model EnrollmentChallenge {
  id              String    @id @default(uuid()) @db.Uuid
  deviceId        String    @db.Uuid
  userId          String    @db.Uuid
  tokenHash       String    @unique
  nonce           String    @unique
  purpose         String    @default("DEVICE_ENROLLMENT")
  issuedAt        DateTime  @default(now())
  expiresAt       DateTime
  proofVerifiedAt DateTime?
  consumedAt      DateTime?

  device          Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([userId])
  @@index([expiresAt])
}

model DeviceAuthNonce {
  id         String   @id @default(uuid()) @db.Uuid
  deviceId   String   @db.Uuid
  nonce      String
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, nonce])
  @@index([expiresAt])
}

model DeviceSession {
  id                  String      @id @default(uuid()) @db.Uuid
  userId              String      @db.Uuid
  deviceId            String?     @db.Uuid
  sessionType         SessionType @default(WEB_CONSOLE)
  tokenHash           String      @unique
  csrfTokenHash       String
  mfaVerified         Boolean     @default(false)
  mfaVerifiedAt       DateTime?
  stepUpVerifiedUntil DateTime?
  stepUpActionScope   String?
  ipAddressTruncated  String?
  userAgentSummary    String?
  createdAt           DateTime    @default(now())
  lastActiveAt        DateTime    @default(now())
  expiresAt           DateTime
  absoluteExpiresAt   DateTime
  revokedAt           DateTime?

  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device              Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model AuditLog {
  id                String   @id @default(uuid()) @db.Uuid
  sequenceNumber    Int      @unique @default(autoincrement())
  actorUserId       String?  @db.Uuid
  actorDeviceId     String?  @db.Uuid
  eventType         String
  timestamp         DateTime @default(now())
  metadata          Json     @default("{}")
  previousEntryHash String
  entryHash         String   @unique

  actorUser         User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorDevice       Device?  @relation(fields: [actorDeviceId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([eventType])
  @@index([timestamp])
}

model Notification {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  type              String
  severity          String
  category          String    @default("Security")
  title             String
  message           String
  createdAt         DateTime  @default(now())
  readAt            DateTime?
  dismissedAt       DateTime?
  relatedDeviceId   String?   @db.Uuid
  relatedDeviceName String?
  relatedEventId    String?
  actionLabel       String?
  actionTarget      String?
  metadata          Json      @default("{}")

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedDevice     Device?   @relation(fields: [relatedDeviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([readAt])
  @@index([severity])
  @@index([userId, dismissedAt, readAt])
}

model RemoteCommand {
  id              String         @id @default(uuid()) @db.Uuid
  deviceId        String         @db.Uuid
  issuerUserId    String         @db.Uuid
  actionType      String
  status          String
  statusMessage   String
  nonce           String         @default(uuid())
  payloadSummary  Json           @default("{}")
  requestedAt     DateTime       @default(now())
  deliveredAt     DateTime?
  acknowledgedAt  DateTime?
  completedAt     DateTime?
  expiresAt       DateTime?

  device          Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  issuerUser      User           @relation(fields: [issuerUserId], references: [id], onDelete: Cascade)
  result          CommandResult?

  @@index([deviceId])
  @@index([issuerUserId])
  @@index([status])
  @@index([requestedAt])
  @@index([expiresAt])
  @@index([issuerUserId, requestedAt])
}

model CommandResult {
  id              String    @id @default(uuid()) @db.Uuid
  commandId       String    @unique @db.Uuid
  deviceId        String    @db.Uuid
  status          String
  receivedAt      DateTime  @default(now())
  completedAt     DateTime?
  errorCode       String?
  safeMessage     String
  deviceTimestamp DateTime?
  resultMetadata  Json      @default("{}")

  command         RemoteCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)
  device          Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([commandId])
  @@index([deviceId])
}

model SecurityEvent {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  deviceId      String?  @db.Uuid
  category      String
  type          String
  severity      String
  occurredAt    DateTime @default(now())
  receivedAt    DateTime @default(now())
  title         String
  description   String
  metadata      Json     @default("{}")
  source        String   @default("WEB")
  correlationId String?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device        Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deviceId])
  @@index([category])
  @@index([type])
  @@index([severity])
  @@index([occurredAt])
  @@index([userId, occurredAt])
}

model DeviceHeartbeat {
  id                        String   @id @default(uuid()) @db.Uuid
  deviceId                  String   @db.Uuid
  connectivityStatus        String   @default("ONLINE")
  batteryLevel              Int?
  charging                  Boolean?
  networkType               String   @default("UNKNOWN")
  osVersion                 String?
  agentVersion              String?
  permissionSummary         String?
  securitySummary           String?
  locationPermissionGranted Boolean?
  receivedAt                DateTime @default(now())

  device                    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([receivedAt])
}

model RiskAssessment {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  deviceId        String?  @db.Uuid
  score           Int
  status          String
  factors         Json     @default("[]")
  recommendations Json     @default("[]")
  updatedAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device          Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deviceId])
  @@index([updatedAt])
}

model ThreatCheck {
  id                  String            @id @default(uuid()) @db.Uuid
  userId              String            @db.Uuid
  deviceId            String?           @db.Uuid
  submittedUrl        String
  normalizedDomain    String
  verdict             String
  riskScore           Int               @default(0)
  summary             String
  recommendedGuidance String
  source              String            @default("WEB")
  checkedAt           DateTime          @default(now())

  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  device              Device?           @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  indicators          ThreatIndicator[]

  @@index([userId])
  @@index([deviceId])
  @@index([normalizedDomain])
  @@index([verdict])
  @@index([checkedAt])
  @@index([userId, checkedAt])
}

model ThreatIndicator {
  id            String      @id @default(uuid()) @db.Uuid
  threatCheckId String      @db.Uuid
  code          String
  category      String
  severity      String
  title         String
  explanation   String
  weight        Int         @default(0)
  createdAt     DateTime    @default(now())

  threatCheck   ThreatCheck @relation(fields: [threatCheckId], references: [id], onDelete: Cascade)

  @@index([threatCheckId])
  @@index([code])
  @@index([severity])
}


